# ─────────────────────────────────────────────────────────────
# IGIRE — environment variables
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string used by Prisma. Prisma requires a replica set, so the
# URL includes replicaSet + directConnection to match docker-compose.yml.
DATABASE_URL="mongodb://localhost:27017/igire?replicaSet=rs0&directConnection=true"

# Secret used by Auth.js (NextAuth v5) to sign/encrypt session tokens.
# Generate one with: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

RESEND_API_KEY="re_replace_me"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# From-address used for outgoing email (must be a verified Resend domain).
EMAIL_FROM="IGIRE <no-reply@igire.example>"
